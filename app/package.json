{
  "name": "soniox-live-uebersetzung",
  "version": "0.1.0",
  "description": "Live-Übersetzungs-Demo (Soniox) als native macOS-App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.soniox.translate-demo",
    "productName": "LiveTranslate",
    "files": [
      "main.js"
    ],
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Die App übersetzt Sprache in Echtzeit und benötigt Mikrofonzugriff.",
        "CFBundleDisplayName": "Live Übersetzung"
      }
    }
  }
}